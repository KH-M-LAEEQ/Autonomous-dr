{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fault episode ground truth",
  "description": "One row per injected fault. `start`/`end` are the exact virtual-clock bounds of the fault window. A window overlapping [start, end) for a resource listed in `affected` is anomalous; everything else is normal.",
  "type": "object",
  "required": [
    "episode",
    "fault_type",
    "target",
    "affected",
    "start",
    "end"
  ],
  "additionalProperties": false,
  "properties": {
    "episode": {
      "type": "integer",
      "minimum": 0
    },
    "fault_type": {
      "type": "string",
      "enum": [
        "cpu_hog",
        "latency",
        "stop",
        "pause",
        "region_down"
      ]
    },
    "target": {
      "type": "string",
      "description": "resource the fault was injected against"
    },
    "tenant_id": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "affected": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "every resource degraded by this fault, including `target`"
    },
    "start": {
      "type": "string",
      "format": "date-time"
    },
    "end": {
      "type": "string",
      "format": "date-time"
    },
    "duration_seconds": {
      "type": "integer",
      "minimum": 1
    }
  }
}
