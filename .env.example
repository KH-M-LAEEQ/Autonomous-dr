# ---------------------------------------------------------------------------
# Copy to .env and fill in.  .env is gitignored.  NEVER commit a real secret.
# Everyone on the team uses the same local values below so bugs reproduce.
# ---------------------------------------------------------------------------

APP_ENV=local
LOG_LEVEL=INFO

# --- Postgres (Docker) -----------------------------------------------------
POSTGRES_USER=adr
POSTGRES_PASSWORD=adr_dev_password
POSTGRES_DB=adr
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://adr:adr_dev_password@localhost:5432/adr

# --- Redis (Docker) — Celery broker + result backend -----------------------
REDIS_URL=redis://localhost:6379/0

# --- InfluxDB (Docker) — time-series telemetry -----------------------------
INFLUX_URL=http://localhost:8086
INFLUX_ORG=autonomousdr
INFLUX_BUCKET=telemetry
INFLUX_TOKEN=dev-token-change-me
INFLUX_ADMIN_USER=admin
INFLUX_ADMIN_PASSWORD=adr_dev_password

# --- API -------------------------------------------------------------------
API_HOST=0.0.0.0
# 8001, not 8000 -- 8000 is a common default other local dev servers squat on.
API_PORT=8001
CORS_ORIGINS=http://localhost:5173

# --- Feature switches (config-driven swapping of frozen interfaces) --------
PROVIDERS=simulated
DETECTOR=threshold
CONSENSUS=quorum
EXECUTOR=simulated
EXPLAINER=template

# --- Cloud credentials: leave EMPTY until Week 7. Set the billing alarm first.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GOOGLE_APPLICATION_CREDENTIALS=

# --- LLM (Week 16) ---------------------------------------------------------
GROQ_API_KEY=

# --- Budget gate -----------------------------------------------------------
DEFAULT_MONTHLY_BUDGET_USD=25
